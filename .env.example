# Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
PUBLIC_BASE_URL=https://pay.example.com

# Optional. Leave empty to generate DATA_DIR/.master-key on first startup.
# If supplied by a secret manager, generate it with: openssl rand -base64 32
# Never change it after encrypted credentials have been saved.
APP_MASTER_KEY=

# Keep disabled unless callback receivers are intentionally on a private network.
ALLOW_PRIVATE_CALLBACKS=false

# Optional when deployed behind a trusted reverse proxy.
TRUST_PROXY=false

# Frontend production build (`vite build`). Public analytics ids, not secrets.
# Defaults used by production builds are in .env.production. Leave unset to skip the tracker.
# VITE_VISORA_URL=https://visora.lvyrix.com
# VITE_VISORA_SITE_ID=v_5e3641ed7a16f9b12a98eb74
